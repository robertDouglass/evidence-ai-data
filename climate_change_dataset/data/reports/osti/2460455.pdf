  "distribution": [{"@type":"DataDownload","about":"NCDB Official website. Provides useful information about what the NCDB is, related publications, and outlines potential data applications.","encodingFormat":"website","isAccessibleForFree":true,"contentUrl":"https:\/\/climate.nrel.gov\/","spatialCoverage":{"@type":"Place","geo":{"@type":"GeoShape","box":"25.859431034049 -126.154525 49.720412758647 -66.5318"}}},{"@type":"DataDownload","about":"Website for North American Coordinated Regional Climate Downscaling Experiment (NA-CORDEX) with more information and climate projections that were used in the NCDB modeling.","encodingFormat":"website","isAccessibleForFree":true,"contentUrl":"https:\/\/na-cordex.org\/","spatialCoverage":{"@type":"Place","geo":{"@type":"GeoShape","box":"13.518 -167.7267 75.0714 -53.8316"}}},{"@type":"DataDownload","about":"AWS public dataset program registry page for data released as part of the National Climate Database. The registry page contains information about dataset documentation, access, and contact, for the NCDB Data Lake datasets.","encodingFormat":"website","isAccessibleForFree":true,"contentUrl":"https:\/\/registry.opendata.aws\/nrel-pds-ncdb\/","spatialCoverage":{"@type":"Place","geo":{"@type":"GeoShape","box":"-83 -180 83 180"}}},{"@type":"DataDownload","about":"Examples of using the HSDS Service to Access NREL NCDB data. ","encodingFormat":"code","isAccessibleForFree":true,"contentUrl":"https:\/\/github.com\/NREL\/hsds-examples\/blob\/master\/notebooks\/10_NCDB_introduction.ipynb","spatialCoverage":{"@type":"Place","geo":{"@type":"GeoShape","box":"-83 -180 83 180"}}},{"@type":"DataDownload","about":"NCDB high resolution, bias-corrected climate dataset in AWS S3. ","encodingFormat":"data","isAccessibleForFree":true,"contentUrl":"https:\/\/data.openei.org\/s3_viewer?bucket=nrel-pds-ncdb","spatialCoverage":{"@type":"Place","geo":{"@type":"GeoShape","box":"-83 -180 83 180"}}}],
